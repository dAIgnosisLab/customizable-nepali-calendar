# Ignore source files (CLI package, not a library)
src/

# Keep templates for CLI to copy
!templates/

# Build configs (not needed for CLI)
.babelrc
babel.config.js
vite.config.*
webpack.config.*
rollup.config.*

# Tests & docs
__tests__/
tests/
docs/
.storybook/

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS / editor junk
.DS_Store
.vscode/
.idea/

# Env files
.env
.env.*

# Lockfiles (npm will generate its own)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Misc
coverage/
dist/
